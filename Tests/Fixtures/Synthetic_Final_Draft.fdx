    <Paragraph Type="Action" id="synthetic-paragraph-0001">
      <Text>THE PAPER BRIDGE</Text>
    </Paragraph>
    <Paragraph Type="Action" id="synthetic-paragraph-0002">
      <Text>A synthetic routing exercise</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading" id="synthetic-paragraph-0003">
      <Text>INT. MODEL WORKSHOP - DAY</Text>
    </Paragraph>
    <Paragraph Type="Action" id="synthetic-paragraph-0004">
      <Text>Mara sets a </Text>
      <Text Style="Bold">folded map</Text>
      <Text> beside the tram.</Text>
    </Paragraph>
    <Paragraph Type="Shot" id="synthetic-paragraph-0005">
      <Text>CLOSE ON CARD 01</Text>
    </Paragraph>
    <Paragraph Type="Character" id="synthetic-paragraph-0006">
      <Text>MARA</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical" id="synthetic-paragraph-0007">
      <Text>(reading the card)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="synthetic-paragraph-0008">
      <Text>Route 01 is ready.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="synthetic-paragraph-0009">
      <Text>Ivo turns the dial once.</Text>
    </Paragraph>
    <Paragraph Type="Character" id="synthetic-paragraph-0010">
      <Text>IVO</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="synthetic-paragraph-0011">
      <Text>The paper bridge is level.</Text>
    </Paragraph>
    <Paragraph Type="Action" id="synthetic-paragraph-0015">
      <Text>A </Text>
      <Text Style="Italic">café</Text>
      <Text> label reads é. </Text>
      <Text Style="Underline">🚀</Text>
    </Paragraph>
    <Paragraph Type="Character" id="synthetic-paragraph-0023">
      <Text>UMA</Text>
    </Paragraph>
    <Paragraph Type="Dialogue" id="synthetic-paragraph-0024">
      <Text>Keep the ruler in the frame.</Text>
    </Paragraph>
